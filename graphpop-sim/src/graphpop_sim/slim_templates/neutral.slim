// Neutral burn-in template (graphpop-sim M12.B).
// Parameters (use --params key=value to override):
//   Ne            effective population size (default 1000)
//   sequence_len  sequence length in bp (default 1e6)
//   recomb_rate   per-bp recombination rate (default 1e-8)
//   mut_rate      per-bp mutation rate (default 1e-8)
//   gens          number of generations to simulate (default 10000)
//   seed          RNG seed (default 42)
//   output_path   output .trees file (required)

initialize() {
    setSeed(seed);
    initializeTreeSeq();
    initializeMutationRate(mut_rate);
    initializeMutationType("m1", 0.5, "f", 0.0);  // neutral
    initializeGenomicElementType("g1", m1, 1.0);
    initializeGenomicElement(g1, 0, asInteger(sequence_len) - 1);
    initializeRecombinationRate(recomb_rate);
}

1 early() {
    sim.addSubpop("p1", asInteger(Ne));
}

gens late() {
    sim.treeSeqOutput(output_path);
    sim.simulationFinished();
}
